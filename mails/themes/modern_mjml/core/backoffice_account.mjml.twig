{% extends '@MjmlMailThemes/modern_mjml/components/layout.mjml.twig' %}

{% block title %}{{ 'Your account has been created'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}
<mj-section padding="0 25px">
  <mj-column padding="0">

    <mj-raw>
      <!-- TITLE BEGINING -->
    </mj-raw>
    <mj-text padding-top="0" padding-bottom="20px" font-weight="600" font-size="20px">
      {{ 'Hi {firstname} {lastname},'|trans({}, 'Emails.Body', locale) }}
    </mj-text>
    <mj-raw>
      <!-- TITLE ENDING -->
    </mj-raw>

  </mj-column>
</mj-section>

<mj-raw>
  <!-- BORDER BEGINING -->
</mj-raw>
<mj-section text-align="left" padding="0 50px 40px">
  <mj-column width="25px">
    <mj-divider width="25px" css-class="left" padding-top="0" padding-left="0" padding-right="0" border-width="3px" border-color="#505050" border-style="solid"></mj-divider>
  </mj-column>
</mj-section>
<mj-raw>
  <!-- BORDER ENDING -->
</mj-raw>

<mj-raw>
  <!-- SUBTITLE BEGINING -->
</mj-raw>
<mj-section padding="0 25px">
  <mj-column padding="0">
    <mj-text padding-bottom="0px" padding-top="0px" font-size="16px" font-weight="600">
      {{ 'Your account has been created'|trans({}, 'Emails.Body', locale) }}
    </mj-text>
  </mj-column>
</mj-section>
<mj-raw>
  <!-- SUBTITLE ENDING -->
</mj-raw>

<mj-raw>
  <!-- BOX BEGINING -->
</mj-raw>
<mj-section padding="15px 50px 40px">
  <mj-column background-color="#fefefe" border="1px solid #DFDFDF" padding="20px 0">
    <mj-text>
      {{ 'An account has been created on your behalf on [1]{shop_name}[/1].'|trans({'[1]': '<span class="label">', '[/1]': '</span>'}, 'Emails.Body', locale)|raw_purified }}
    </mj-text>
    <mj-text padding-top="0px">
      <span class="label">{{ 'Email address:'|trans({}, 'Emails.Body', locale) }}</span>&nbsp;<span style="color:#25B9D7;font-weight:600">{email}</span>
    </mj-text>
    <mj-text padding-top="0px">
      {{ 'Click on the following link to set up your password:'|trans({}, 'Emails.Body', locale) }} <a href="{url}" target="_blank" style="color:#25B9D7; font-weight:600;">{url}</a>
    </mj-text>
    <mj-text padding-top="0px">
      {{ 'This link is valid for a limited time only. After it expires, you can get a new one with the "Forgot your password?" link on the login page.'|trans({}, 'Emails.Body', locale) }}
    </mj-text>
  </mj-column>
</mj-section>
<mj-raw>
  <!-- BOX ENDING -->
</mj-raw>

<mj-raw>
  <!-- CENTER TEXT BEGINING -->
</mj-raw>
<mj-section padding="0 25px 20px">
  <mj-column>
    <mj-text align="center">
      {{ 'You can access your customer account on our store:'|trans({}, 'Emails.Body', locale) }} <a href="{shop_url}" target="_blank" style="text-decoration:none;color:#25B9D7; display:block">{shop_name}</a>
    </mj-text>
  </mj-column>
</mj-section>
<mj-raw>
  <!-- CENTER TEXT ENDING -->
</mj-raw>
{% endblock %}
